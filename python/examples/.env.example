# .env.example — config for the async-xenapi example tools
#   xsvm create …    create + start a VM
#   xsvm console …   relay a VM's VNC console to a local port
#   xscert setup …   client-certificate auth: onboard, log in, probe, revert
#
# Setup:  cp .env.example .env  then edit. Auto-loaded from the current dir and
# the script's own dir. Precedence: real env var > .env file > built-in default;
# any value is also overridable per-run by a CLI flag.

XS_HOST=your-host.example.net   # XenServer host or pool master (IP/hostname)
XS_USER=root                    # host root account
XS_PASSWORD=changeme            # root password — keep the real .env out of version control
XS_LOCAL_PORT=5901              # xsvm console default local VNC port (optional)

# xscert only. XS_CERT_NAME is the checkHost name: stunnel requires the presented
# certificate's CN/SAN to equal the pool's client_certificate_auth_name.
XS_CERT_NAME=async-xenapi-demo  # certificate CN/SAN == pool client_certificate_auth_name
XS_CERT_DIR=./certs             # where xscert writes the CA and client certificate
